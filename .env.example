# GitHub repo that hosts version.txt (used on every launch during splash)
# Example: https://github.com/saakethban/faibilo-browser
FAIBILO_UPDATE_REPO=https://github.com/saakethban/faibilo-browser

# Optional branch (default: main)
FAIBILO_UPDATE_BRANCH=main

# Direct URL to version.txt (recommended if you use refs/heads in the raw URL)
# Example: https://raw.githubusercontent.com/saakethban/faibilo-browser/main/version.txt
FAIBILO_VERSION_URL=https://raw.githubusercontent.com/saakethban/faibilo-browser/main/version.txt
